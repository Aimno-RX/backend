# ============================================
# LLM Graph Builder - 环境变量配置模板
# 支持 OpenAI、DeepSeek、Kimi、豆包
# ============================================

# ==================== Neo4j 数据库配置（必填）====================
NEO4J_URI=bolt://your_neo4j_host:7687
NEO4J_USERNAME=your_neo4j_username
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j

# ==================== OpenAI 配置 ====================
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI 模型配置
LLM_MODEL_CONFIG_openai_gpt_4o=gpt-4o,sk-your-openai-api-key-here
LLM_MODEL_CONFIG_openai_gpt_4o_mini=gpt-4o-mini,sk-your-openai-api-key-here
LLM_MODEL_CONFIG_openai_gpt_4_turbo=gpt-4-turbo,sk-your-openai-api-key-here

# ==================== DeepSeek 配置 ====================
# DeepSeek API Key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek 模型配置（通过 OpenAI 兼容接口）
LLM_MODEL_CONFIG_deepseek_chat=deepseek-chat,https://api.deepseek.com,sk-your-deepseek-api-key-here
LLM_MODEL_CONFIG_deepseek_coder=deepseek-coder,https://api.deepseek.com,sk-your-deepseek-api-key-here

# ==================== Kimi (月之暗面) 配置 ====================
# Kimi API Key
KIMI_API_KEY=sk-your-kimi-api-key-here

# Kimi 模型配置（通过 OpenAI 兼容接口）
LLM_MODEL_CONFIG_kimi_moonshot_v1_8k=moonshot-v1-8k,https://api.moonshot.cn/v1,sk-your-kimi-api-key-here
LLM_MODEL_CONFIG_kimi_moonshot_v1_32k=moonshot-v1-32k,https://api.moonshot.cn/v1,sk-your-kimi-api-key-here
LLM_MODEL_CONFIG_kimi_moonshot_v1_128k=moonshot-v1-128k,https://api.moonshot.cn/v1,sk-your-kimi-api-key-here

# ==================== 豆包 (字节跳动) 配置 ====================
# 豆包 API Key
DOUBAO_API_KEY=your-doubao-api-key-here

# 豆包模型配置（通过 OpenAI 兼容接口）
LLM_MODEL_CONFIG_doubao_pro_4k=doubao-pro-4k,https://ark.cn-beijing.volces.com/api/v3,your-doubao-api-key-here
LLM_MODEL_CONFIG_doubao_pro_32k=doubao-pro-32k,https://ark.cn-beijing.volces.com/api/v3,your-doubao-api-key-here
LLM_MODEL_CONFIG_doubao_lite_4k=doubao-lite-4k,https://ark.cn-beijing.volces.com/api/v3,your-doubao-api-key-here

# ==================== 其他 LLM 配置（可选）====================
# Gemini
LLM_MODEL_CONFIG_gemini_1_5_flash=gemini-1.5-flash
LLM_MODEL_CONFIG_gemini_1_5_pro=gemini-1.5-pro

# Diffbot
DIFFBOT_API_KEY=your-diffbot-api-key-here
LLM_MODEL_CONFIG_diffbot=diffbot,your-diffbot-api-key-here

# ==================== 嵌入模型配置 ====================
EMBEDDING_MODEL=
RAGAS_EMBEDDING_MODEL=openai
IS_EMBEDDING=true
ENTITY_EMBEDDING=false

# ==================== 应用配置 ====================
# 分块配置
MAX_TOKEN_CHUNK_SIZE=1000000
UPDATE_GRAPH_CHUNKS_PROCESSED=20

# KNN 配置
KNN_MIN_SCORE=0.94

# 文件缓存
GCS_FILE_CACHE=false
BUCKET_UPLOAD_FILE=
BUCKET_FAILED_FILE=
PROJECT_ID=

# 日志和监控
GCP_LOG_METRICS_ENABLED=false
ENABLE_USER_AGENT=false
NEO4J_USER_AGENT=LLM-Graph-Builder

# 去重配置
DUPLICATE_SCORE_VALUE=0.97
DUPLICATE_TEXT_DISTANCE=3

# 默认模型
DEFAULT_DIFFBOT_CHAT_MODEL=openai_gpt_4o_mini
GRAPH_CLEANUP_MODEL=openai_gpt_4o_mini

# YouTube 代理（如需要）
YOUTUBE_TRANSCRIPT_PROXY=

# 搜索配置
EFFECTIVE_SEARCH_RATIO=5

# ==================== Token 使用追踪（可选）====================
TRACK_TOKEN_USAGE=false
DAILY_TOKENS_LIMIT=250000
MONTHLY_TOKENS_LIMIT=1000000
TOKEN_TRACKER_DB_URI=
TOKEN_TRACKER_DB_USERNAME=
TOKEN_TRACKER_DB_PASSWORD=
TOKEN_TRACKER_DB_DATABASE=